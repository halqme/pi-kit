{
  "name": "@halqme/pi-kit",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "peerDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
