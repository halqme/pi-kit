{
  "name": "@halqme/pi-kit",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "format": "oxfmt .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "pi-intercom": "^0.10.0"
  },
  "peerDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest"
  },
  "bundledDependencies": [
    "pi-intercom"
  ],
  "catalog": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/pi-intercom/index.ts"
    ],
    "skills": [
      "./skills",
      "./node_modules/pi-intercom/skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
