{
  "name": "@halqme/pi-kit",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "check": "bun run lint && bun run --parallel --workspaces --if-present check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ."
  },
  "peerDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.12.4",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions/repository/index.ts",
      "./extensions/task/index.ts",
      "./extensions/delegate/index.ts",
      "./extensions/background-process/index.ts",
      "./extensions/browser-inspector/index.ts",
      "./extensions/session-metrics/index.ts",
      "./extensions/statusline/index.ts",
      "./extensions/suggest-reload/index.ts",
      "./extensions/terminal/index.ts"
    ],
    "skills": [
      "./skills/apply-correction",
      "./skills/diagnose-problem",
      "./skills/git-workflow",
      "./skills/implement-change",
      "./skills/natural-japanese-writing",
      "./skills/perform-safely",
      "./skills/research-answer",
      "./skills/test-design",
      "./skills/writing-skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
