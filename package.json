{
  "name": "@halqme/pi-kit",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "packages/*",
    "packages/railway/extensions/*"
  ],
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "check": "bun run lint && bun run --parallel --workspaces --if-present check",
    "test": "bun run --parallel --workspaces --if-present test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ."
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "oxlint": "catalog:"
  },
  "pi": {
    "extensions": [
      "./packages/railway/extensions/delegate/index.ts",
      "./packages/railway/extensions/repository/index.ts",
      "./packages/railway/extensions/task/index.ts",
      "./packages/browser-inspector/index.ts",
      "./packages/macos-talk/index.ts"
    ],
    "skills": [
      "./packages/railway/skills/consistency-review",
      "./packages/railway/skills/git-workflow",
      "./packages/railway/skills/implement-change"
    ]
  }
}
