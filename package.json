{
  "name": "@halqme/pi-kit",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "format": "oxfmt .",
    "lint": "oxlint ."
  },
  "peerDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest"
  },
  "catalog": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
